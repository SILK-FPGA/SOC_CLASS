module buffer_AI (
    input  logic         rstn_i,

    // =====================================================
    // AVALON WRITE SIDE
    // 4 beat x 256 bit = 1024 bit = ảnh 32x32
    // =====================================================
    input  logic         avl_clk_i,
    input  logic         avl_reset_i,
    input  logic [255:0] avl_data_i,
    input  logic         avl_enable_i,
    output logic         avl_done_o,

    // =====================================================
    // AI CLOCK DOMAIN
    // =====================================================
    input  logic         ai_clk_i,

    output logic         ai_busy_o,
    output logic         ai_stream_done_o,

    // Kết quả từ bdscnn_top
    output logic         sys_valid_o,
    output logic [3:0]   class_out_o
);

    localparam int H_RES      = 32;
    localparam int V_RES      = 32;
    localparam int FRAME_BITS = H_RES * V_RES;       // 1024 bit
    localparam int AVL_WORDS  = FRAME_BITS / 256;    // 4 beat

    // =====================================================
    // FRAME BUFFER
    //
    // frame_bits[0]    = pixel (0,0)
    // frame_bits[31]   = pixel (31,0)
    // frame_bits[32]   = pixel (0,1)
    // frame_bits[1023] = pixel (31,31)
    //
    // Nền đen = 0, nét trắng = 1.
    // =====================================================
    logic [FRAME_BITS-1:0] frame_bits;

    // =====================================================
    // AVALON WRITE SIDE
    // Giữ nguyên cơ chế ghi từ buffer_hdmi
    // =====================================================
    logic [2:0] avl_count;
    logic       avl_reset_reg;
    logic       avl_reset_rise;

    assign avl_reset_rise = ~avl_reset_reg & avl_reset_i;

    always_ff @(posedge avl_clk_i) begin
        if (!rstn_i) begin
            avl_reset_reg <= 1'b0;
            avl_count     <= 3'd0;
            avl_done_o    <= 1'b0;
            frame_bits    <= '0;
        end else begin
            avl_reset_reg <= avl_reset_i;

            if (avl_reset_rise) begin
                avl_count  <= 3'd0;
                avl_done_o <= 1'b0;
            end else if (avl_enable_i && !avl_done_o) begin
                case (avl_count)
                    3'd0: frame_bits[ 255:  0] <= avl_data_i;
                    3'd1: frame_bits[ 511:256] <= avl_data_i;
                    3'd2: frame_bits[ 767:512] <= avl_data_i;
                    3'd3: frame_bits[1023:768] <= avl_data_i;
                    default: ;
                endcase

                if (avl_count == 3'd3) begin
                    avl_done_o <= 1'b1;
                end else begin
                    avl_count <= avl_count + 3'd1;
                end
            end
        end
    end

    // =====================================================
    // CLOCK DOMAIN CROSSING
    //
    // Đồng bộ avl_done_o sang ai_clk_i.
    // frame_bits đứng yên sau avl_done_o = 1.
    // =====================================================
    logic avl_done_meta;
    logic avl_done_ai;
    logic avl_done_ai_d;
    logic avl_done_ai_rise;

    assign avl_done_ai_rise = avl_done_ai & ~avl_done_ai_d;

    always_ff @(posedge ai_clk_i) begin
        if (!rstn_i) begin
            avl_done_meta <= 1'b0;
            avl_done_ai   <= 1'b0;
            avl_done_ai_d <= 1'b0;
        end else begin
            avl_done_meta <= avl_done_o;
            avl_done_ai   <= avl_done_meta;
            avl_done_ai_d <= avl_done_ai;
        end
    end

    // Bản sao frame dùng trong clock AI.
    logic [FRAME_BITS-1:0] ai_frame_bits;

    // =====================================================
    // AI STREAM CONTROL
    // =====================================================
    typedef enum logic [2:0] {
        AI_IDLE,
        AI_SETTLE,
        AI_RELEASE_RESET,
        AI_STREAM,
        AI_WAIT_RESULT
    } ai_state_t;

    ai_state_t ai_state;

    logic [1:0] settle_count;
    logic [9:0] pixel_index;

    logic       core_rst_n;
    logic       core_img_valid;
    logic       core_img_data;
    logic       core_sys_valid;
    logic [3:0] core_class_out;

    always_comb begin
        ai_busy_o = (ai_state != AI_IDLE);
    end

    always_ff @(posedge ai_clk_i) begin
        if (!rstn_i) begin
            ai_state         <= AI_IDLE;
            settle_count     <= 2'd0;
            pixel_index      <= 10'd0;
            ai_frame_bits    <= '0;

            core_rst_n       <= 1'b0;
            core_img_valid   <= 1'b0;
            core_img_data    <= 1'b0;

            ai_stream_done_o <= 1'b0;
        end else begin
            // Pulse mặc định
            core_img_valid   <= 1'b0;
            ai_stream_done_o <= 1'b0;

            // Khi Avalon bắt đầu frame mới, avl_done_ai về 0.
            // Reset AI để không đọc frame_bits đang thay đổi.
            if (!avl_done_ai) begin
                ai_state      <= AI_IDLE;
                settle_count  <= 2'd0;
                pixel_index   <= 10'd0;
                core_rst_n    <= 1'b0;
                core_img_data <= 1'b0;
            end else begin
                case (ai_state)
                    AI_IDLE: begin
                        core_rst_n <= 1'b0;
                        pixel_index <= 10'd0;

                        if (avl_done_ai_rise) begin
                            settle_count <= 2'd0;
                            ai_state     <= AI_SETTLE;
                        end
                    end

                    // Chờ thêm 3 clock AI rồi chụp frame_bits.
                    AI_SETTLE: begin
                        core_rst_n <= 1'b0;

                        if (settle_count == 2'd2) begin
                            ai_frame_bits <= frame_bits;
                            settle_count  <= 2'd0;
                            ai_state      <= AI_RELEASE_RESET;
                        end else begin
                            settle_count <= settle_count + 2'd1;
                        end
                    end

                    // Nhả reset AI trước khi phát pixel.
                    AI_RELEASE_RESET: begin
                        core_rst_n  <= 1'b1;
                        pixel_index <= 10'd0;
                        ai_state    <= AI_STREAM;
                    end

                    // Phát 1024 pixel, 1 bit mỗi chu kỳ.
                    AI_STREAM: begin
                        core_rst_n     <= 1'b1;
                        core_img_valid <= 1'b1;
                        core_img_data  <= ai_frame_bits[pixel_index];

                        if (pixel_index == 10'd1023) begin
                            pixel_index      <= 10'd0;
                            ai_stream_done_o <= 1'b1;
                            ai_state         <= AI_WAIT_RESULT;
                        end else begin
                            pixel_index <= pixel_index + 10'd1;
                        end
                    end

                    // Chờ bdscnn_top trả kết quả.
                    // Khi sys_valid lên, kết thúc phiên xử lý hiện tại.
                    // Không chạy lại cùng frame vì avl_done_ai_rise
                    // chỉ xuất hiện sau khi Avalon nạp frame mới.
                    AI_WAIT_RESULT: begin
                        core_rst_n <= 1'b1;

                        if (core_sys_valid) begin
                            ai_state <= AI_IDLE;
                        end
                    end

                    default: begin
                        ai_state   <= AI_IDLE;
                        core_rst_n <= 1'b0;
                    end
                endcase
            end
        end
    end

    // =====================================================
    // BDSCNN CORE
    // =====================================================
    bdscnn_top u_bdscnn_top (
        .clk       (ai_clk_i),
        .rst_n     (core_rst_n),

        .img_valid (core_img_valid),
        .img_data  (core_img_data),

        .sys_valid (core_sys_valid),
        .class_out (core_class_out)
    );

    assign sys_valid_o = core_sys_valid;
    assign class_out_o = core_class_out;

endmodule
